---
import '../styles/global.css';
import type { Lang } from '../i18n';
import { ui } from '../i18n';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = 'ru', title, description } = Astro.props;
const t = ui[lang];

const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

const origin = (Astro.site ?? new URL('https://sculpt.metodsk.ru/')).origin;
const urlRu = new URL('/', origin).href;
const urlEn = new URL('/en/', origin).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="ru" href={urlRu} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlRu} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="text-ink antialiased">
    <slot />
  </body>
</html>
