---
import Container from '../ui/Container.astro';
import TextBlock from '../ui/TextBlock.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { material as materialRu } from '../../data/material';
import { material as materialEn } from '../../data/en/material';
import type { Lang } from '../../i18n';
import { ui } from '../../i18n';
import type { ImageMetadata } from 'astro';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const material = lang === 'en' ? materialEn : materialRu;
const t = ui[lang];

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/material/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);

const photos = material.images.map((photo) => ({
  ...photo,
  image: photo.image ? (images[photo.image]?.default?.src ?? null) : null,
}));
---

<section id="material" class="zone-archive relative overflow-hidden py-10 md:py-14">
  <span aria-hidden="true" class="ghost-word bottom-[1vw] left-[-4vw] text-[14vw] text-[rgba(31,26,18,0.06)] md:left-[-2vw] md:text-[8vw]">{t.ghosts.material}</span>
  <Container className="relative z-[2]">
    <TextBlock>
      <SectionHeader number={material.number} title={material.title} />
      <p class="mt-10 text-justify text-step-2 leading-relaxed text-ink/60">
        {material.lead} {material.body}
      </p>
    </TextBlock>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      {photos.map((photo) => (
        photo.image && (
          <img
            src={photo.image}
            alt={photo.alt}
            loading="lazy"
            class="block h-auto w-full object-contain"
          />
        )
      ))}
    </div>
  </Container>
</section>
