---
import Container from '../ui/Container.astro';
import TextBlock from '../ui/TextBlock.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { gallery as galleryRu } from '../../data/gallery';
import { gallery as galleryEn } from '../../data/en/gallery';
import type { Lang } from '../../i18n';
import type { ImageMetadata } from 'astro';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const gallery = lang === 'en' ? galleryEn : galleryRu;

const images = import.meta.glob<{ default: ImageMetadata }>(
  ['/src/assets/gallery/*.{jpg,jpeg,png,webp,avif}', '/src/assets/gallery/graded/*.{jpg,jpeg,png,webp,avif}'],
  { eager: true },
);

const photos = gallery.photos.map((photo) => ({
  ...photo,
  image: photo.image ? (images[photo.image]?.default?.src ?? null) : null,
}));

const slots = [
  { cls: 'md:col-span-6', ratio: 'aspect-[5/11]' },
  { cls: 'md:col-span-5 md:col-start-8 md:mt-28', ratio: 'aspect-[9/18]' },
  { cls: 'md:col-span-4', ratio: 'aspect-[9/18]' },
  { cls: 'md:col-span-7 md:col-start-6', ratio: 'aspect-[9/14]' },
  { cls: 'md:col-span-7 md:mt-16', ratio: 'aspect-[6/13]' },
  { cls: 'md:col-span-5', ratio: 'aspect-[10/19]' },
];

const composed = photos
  .map((photo, i) => ({ photo, ...(slots[i] ?? { cls: '', ratio: 'aspect-[9/18]' }) }))
  .filter((entry) => Boolean(entry.photo?.image));
---

<section id="gallery" class="zone-photo relative overflow-hidden py-10 md:py-14">
  <span aria-hidden="true" class="ghost-num right-[1vw] top-[-2vw] text-[30vw] text-[rgba(236,222,196,0.06)] md:right-[2vw] md:text-[15vw]">03</span>
  <Container className="relative z-[2]">
    <TextBlock>
      <SectionHeader number={gallery.number} title={gallery.title} />
    </TextBlock>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-x-8 md:gap-y-16">
      {composed.map(({ photo, cls, ratio }) => (
        <figure class:list={[cls, 'w-full']}>
          <img
            src={photo.image}
            alt={photo.alt}
            loading="lazy"
            class:list={['block w-full object-cover', ratio]}
          />
        </figure>
      ))}
    </div>
  </Container>
</section>
