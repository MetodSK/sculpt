---
import Container from '../ui/Container.astro';
import TextBlock from '../ui/TextBlock.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { storage as storageRu } from '../../data/storage';
import { storage as storageEn } from '../../data/en/storage';
import type { Lang } from '../../i18n';
import { ui } from '../../i18n';
import type { ImageMetadata } from 'astro';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const storage = lang === 'en' ? storageEn : storageRu;
const t = ui[lang];

const images = import.meta.glob<{ default: ImageMetadata }>(
  ['/src/assets/gallery/*.{jpg,jpeg,png,webp,avif}', '/src/assets/gallery/graded/*.{jpg,jpeg,png,webp,avif}'],
  { eager: true },
);

const image = storage.image ? (images[storage.image]?.default?.src ?? null) : null;
---

<section id="fragility" class="zone-doc relative overflow-hidden py-10 md:py-14">
  <span aria-hidden="true" class="ghost-word right-[-4vw] top-[1vw] text-[13vw] text-[rgba(236,222,196,0.07)] md:right-[-2vw] md:text-[7.5vw]">{t.ghosts.condition}</span>
  <Container className="relative z-[2]">
    <TextBlock>
      <SectionHeader number={storage.number} title={storage.title} />
      <div class="mt-10 space-y-5 text-justify text-step-2 leading-relaxed text-ink/60">
        {storage.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </TextBlock>
    <div class="mt-10 border-y border-[#caa36a]/25 py-6">
      {image && (
        <img
          src={image}
          alt={storage.imageAlt}
          loading="lazy"
          class="block h-auto w-full object-contain"
        />
      )}
    </div>
  </Container>
</section>
