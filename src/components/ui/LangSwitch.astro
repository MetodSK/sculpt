---
import type { Lang } from '../../i18n';
import { ui } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = ui[lang];

const langs: Array<{ code: Lang; href: string; label: string }> = [
  { code: 'ru', href: '/', label: 'RU' },
  { code: 'en', href: '/en/', label: 'EN' },
];
---

<nav
  aria-label={t.langSwitchAria}
  class="absolute right-4 top-5 z-[3] flex items-center gap-3 md:right-8 md:top-8 lg:right-16"
>
  {langs.map((item, index) => (
    <>
      {index > 0 && <span aria-hidden="true" class="text-[rgba(240,232,217,0.25)]">|</span>}
      <a
        href={item.href}
        hreflang={item.code}
        aria-current={item.code === lang ? 'true' : undefined}
        class:list={[
          'text-xs font-medium uppercase tracking-[0.2em] transition-colors focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-[#d9bd8a]',
          item.code === lang
            ? 'text-[#d9bd8a] underline decoration-[#d9bd8a]/60 underline-offset-[6px]'
            : 'text-[rgba(240,232,217,0.55)] hover:text-[rgba(240,232,217,0.9)]',
        ]}
      >
        {item.label}
      </a>
    </>
  ))}
</nav>
