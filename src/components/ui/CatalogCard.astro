---
interface Props {
  code: string;
  title: string;
  description: string;
  status?: string;
  aspectRatio?: string;
  className?: string;
  image?: string | null;
  naturalImage?: boolean;
}

const {
  code,
  title,
  description,
  status = 'Фотография будет добавлена после завершения фотосъёмки.',
  aspectRatio = '16/9',
  className = '',
  image = null,
  naturalImage = false,
} = Astro.props;

const src = image;
---

<div
  class:list={[
    'flex flex-col overflow-hidden rounded-sm border border-[#D8D4CC] bg-[#FCFBF8] transition-colors duration-200 hover:border-[#B9B4AA] hover:bg-white',
    className,
  ]}
>
  {src ? (
    <>
      {naturalImage ? (
        <img src={src} alt={title} loading="lazy" class="block h-auto w-full object-contain" />
      ) : (
        <div class="relative w-full overflow-hidden" style={{ aspectRatio }}>
          <img src={src} alt={title} loading="lazy" class="absolute inset-0 h-full w-full object-contain object-center" />
        </div>
      )}
      <div class="flex flex-col gap-1 px-5 pb-5 pt-4 text-left">
        <p class="text-xs font-medium uppercase tracking-[0.3em] text-ink/40 md:text-[0.625rem]">{code}</p>
        <p class="text-sm font-medium text-ink/80">{title}</p>
        <p class="text-xs text-ink/50">{description}</p>
      </div>
    </>
  ) : (
    <div
      class="flex w-full flex-col items-center justify-center gap-2 px-8 text-center md:px-12"
      style={{ aspectRatio }}
    >
      <p class="text-xs font-medium uppercase tracking-[0.3em] text-ink/45 md:text-[0.6875rem]">{code}</p>
      <p class="text-sm font-medium text-ink/80">{title}</p>
      <p class="text-xs text-ink/50">{description}</p>
      <p class="mt-1 max-w-[260px] text-xs text-ink/35 md:text-[0.625rem]">{status}</p>
    </div>
  )}
</div>
